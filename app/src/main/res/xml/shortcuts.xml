<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_noise_cancelling"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_anc"
        android:shortcutShortLabel="@string/shortcut_anc_short"
        android:shortcutLongLabel="@string/shortcut_anc_long">
        <intent
            android:action="com.openairbuds.app.action.SET_NOISE_MODE"
            android:targetPackage="com.openairbuds.app"
            android:targetClass="com.openairbuds.app.shortcut.ShortcutHandlerActivity">
            <extra
                android:name="noise_mode"
                android:value="NOISE_CANCELLATION" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_transparency"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_transparency"
        android:shortcutShortLabel="@string/shortcut_transparency_short"
        android:shortcutLongLabel="@string/shortcut_transparency_long">
        <intent
            android:action="com.openairbuds.app.action.SET_NOISE_MODE"
            android:targetPackage="com.openairbuds.app"
            android:targetClass="com.openairbuds.app.shortcut.ShortcutHandlerActivity">
            <extra
                android:name="noise_mode"
                android:value="TRANSPARENCY" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_normal"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_off"
        android:shortcutShortLabel="@string/shortcut_normal_short"
        android:shortcutLongLabel="@string/shortcut_normal_long">
        <intent
            android:action="com.openairbuds.app.action.SET_NOISE_MODE"
            android:targetPackage="com.openairbuds.app"
            android:targetClass="com.openairbuds.app.shortcut.ShortcutHandlerActivity">
            <extra
                android:name="noise_mode"
                android:value="OFF" />
        </intent>
    </shortcut>
</shortcuts>
